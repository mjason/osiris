{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mjason/osiris/main/schemas/osiris.schema.json",
  "title": "Osiris compiler configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "source": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePath" },
      "default": ["src"]
    },
    "outDir": { "$ref": "#/$defs/relativePath", "default": "dist" },
    "exclude": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativeGlob" },
      "description": "Project-root-relative glob patterns shared by compilation and language tooling. A value without glob syntax also excludes all descendants."
    },
    "targetPython": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "default": "3.11"
    },
    "strict": { "type": "boolean", "default": true },
    "displayLocale": {
      "type": "string",
      "minLength": 1,
      "default": "zh-CN",
      "description": "Default BCP 47 language tag for LSP labels and documentation. Examples include zh-CN, en, and ja; the compiler performs canonical validation and RFC 4647 lookup."
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "default": "deepseek-v4-flash"
        },
        "baseUrl": {
          "type": "string",
          "format": "uri",
          "default": "https://openrouter.ai/api/v1"
        },
        "wireApi": {
          "type": "string",
          "enum": ["responses", "chatCompletions"],
          "default": "chatCompletions",
          "description": "OpenAI-compatible wire protocol: responses calls /responses; chatCompletions calls /chat/completions."
        }
      }
    }
  },
  "$defs": {
    "relativePath": { "type": "string", "minLength": 1 },
    "relativeGlob": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "(^/|(^|/)\\.\\.(/|$))" }
    }
  }
}
